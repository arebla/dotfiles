# File: ~/.config/i3/config

set $mod Mod4
font pango:SF Pro 10, Poppins Regular 10
#font pango:IBM Plex Sans Mono 8

default_border pixel 1
default_floating_border none
hide_edge_borders none
focus_follows_mouse no

bindsym $mod+u border none
bindsym $mod+y border pixel 1
bindsym $mod+n border normal

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
#exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_py3status && ~/.config/dunst/scripts/volume.sh
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_py3status && ~/.config/dunst/scripts/volume.sh
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_py3status && ~/.config/dunst/scripts/volume.sh
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_py3status  && ~/.config/dunst/scripts/microphone.sh

bindsym XF86MonBrightnessUp exec brightnessctl s 5%+ && $refresh_py3status && ~/.config/dunst/scripts/brightness.sh
bindsym XF86MonBrightnessDown exec brightnessctl s 5%- && $refresh_py3status && ~/.config/dunst/scripts/brightness.sh

bindsym --release Print exec "maim -u --select | tee ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png | xclip -selection clipboard -t image/png"
#bindsym --release Print exec "maim --select | tee ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png | xclip -selection clipboard -t image/png && notify-send 'Screenshot' 'Area captured and saved to ~/Pictures/Screenshots' -i camera-photo"
bindsym Ctrl+Print exec "maim -u ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S-FS.png)"

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Start a terminal
bindsym $mod+Return exec kitty

# Kill focused window
bindsym $mod+Shift+q kill

# Start rofi menus
bindsym $mod+d exec --no-startup-id ~/.config/rofi/launcher/launcher.sh
bindsym $mod+0 exec --no-startup-id ~/.config/rofi/powermenu/powermenu.sh

# Move across windows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+semicolon split h;exec notify-send 'tile horizontally'
bindsym $mod+v split v;exec notify-send 'tile vertically'
#bindsym $mod+b split toggle

# Toggle fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
#bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child


set $ws1 "1:I"
set $ws2 "2:II"
set $ws3 "3:III"
set $ws4 "4:IV"
set $ws5 "5:V"
set $ws6 "6:VI"
set $ws7 "7:VII"
set $ws8 "8:τ"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+q workspace $ws4
bindsym $mod+w workspace $ws5
bindsym $mod+e workspace $ws6
bindsym $mod+a workspace $ws7
bindsym $mod+s workspace $ws8

bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8

bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Open applications on specific workspaces
# assign [class="Thunderbird"] $ws1
# assign [class="Pale moon"] $ws2
# assign [class="Pcmanfm"] $ws3
# assign [class="Skype"] $ws5# reload the configuration file

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+0 exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# =======================
# MENÚS
# =======================

bindsym $mod+r mode "Δ"
mode "Δ" {
        bindsym l resize shrink width 5 px or 5 ppt
        bindsym k resize grow height 5 px or 5 ppt
        bindsym j resize shrink height 5 px or 5 ppt
        bindsym h resize grow width 5 px or 5 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# Exec mode # Σ 􀜢  􀣙  􀬚 􀬱 􀯒 􀑃
bindsym $mod+x mode "􀬱"
mode "􀬱" {
#        bindsym e exec libreoffice --calc ~/OneDrive/REG-2425.xlsx &, mode "default"
        bindsym f exec firefox, mode "default"
#        bindsym s exec spotify, mode "default"
        bindsym o exec okular, mode "default"
#        bindsym m exec alacritty -e alsamixer, mode "default"
#        bindsym w exec alacritty -e nmtui, mode "default"
        bindsym r exec alacritty -e ranger &, mode "default"
        bindsym u exec alacritty -e bash -c 'cd ~/OneDrive/Física_USC-G1031V01/ && ranger' &, mode "default"
        bindsym m exec alacritty -e bash -c 'cd ~/msc/ && ranger' &, mode "default"
        bindsym i exec alacritty -e bash -c 'cd ~/.config/nvim/ && ranger' &, mode "default"

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+x mode "default"
}

# Power menu
# bindsym $mod+0 mode "λ"
mode "λ" {
        bindsym l exec "i3lock -c 000000", mode "default"
        bindsym r exec --no-startup-id systemctl reboot
        bindsym p exec --no-startup-id systemctl poweroff

        bindsym Escape mode "default"
        bindsym $mod+0 mode "default"
}


# =======================
# BARRA DE ESTADO
# =======================

bar {
	status_command i3status
	position top
    status_command py3status --config ~/.config/i3/i3status.conf --include ~/.config/i3/modules
	workspace_min_width 50
	padding 2px 8px 2px 2px
	strip_workspace_numbers yes
    separator_symbol "|"

    colors {
        background #3b4d4f
        statusline #FDF6E3
        separator #3b4d4f

#                            border  backgr. textF9FAF9
#        focused_workspace  #3b4d4f #3b4d4f #819fc1
        active_workspace   #353836 #353836 #FDF6E3
        inactive_workspace #3b4d4f #3b4d4f #EEE8D5
        binding_mode       #1d1f21 #1d1f21 #819fc1
        urgent_workspace   #1d1f21 #e46c6d #FDF6E3
        focused_workspace  #1d1f21 #1d1f21 #819fc1

    }

}

# Dual monitor config
#workspace 1 output eDP-1
#workspace $ws2 output HDMI-1

# Autostart applications
exec --no-startup-id nitrogen --restore; sleep 1
exec --no-startup-id redshift
exec --no-startup-id xrandr --dpi 120
exec --no-startup-id $HOME/.scripts/ThinkPad.sh
exec --no-startup-id $HOME/.scripts/remaps.sh

exec --no-startup-id picom -b --config ~/.config/picom/picom.conf
exec --no-startup-id dunst -config ~/.config/dunst/dunstrc

# exec --no-startup-id dbus-update-activation-environment --systemd DBUS_SESSION_BUS_ADDRESS DISPLAY XAUTHORITY


# =======================
# XANELAS FLOTANTES
# =======================

for_window [floating] border none
for_window [class="Thunar"] floating enable
for_window [class="OneDriveGUI"] floating enable
for_window [class="firefox" title="Library"] floating enable
for_window [class="^Anki$" title= "^Engadir$"] floating enable, mark anki_add
for_window [title="Network Connections"] floating enable

# Regras para o script de copiar LaTeX ao portapapeis
for_window [class="LaTeX portapapeis"] floating enable
for_window [class="LaTeX portapapeis"] resize set 900 200
for_window [class="LaTeX portapapeis"] move position center, move down 250px

bindsym $mod+p exec --no-startup-id ~/.scripts/tex_portapapeis.sh
bindsym $mod+Shift+f exec --no-startup-id bash -c 'xclip -selection clipboard < ~/Documents/flashcards_mpt.md'

# See https://github.com/jubnzv/anki-tray
